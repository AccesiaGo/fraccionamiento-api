# Entorno: development | production | test
NODE_ENV=development
PORT=3000

# Pega aqui tu connection string real de MongoDB (Atlas u on-premise).
# NUNCA subas el .env real a git; solo este .env.example va al repositorio.
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/accesia

# JWT (los generamos en el siguiente paso, cuando construyamos el modulo de auth).
# Genera un secreto fuerte, ej: openssl rand -hex 64
JWT_ACCESS_SECRET=cambia_esto_por_un_secreto_largo_y_aleatorio
JWT_REFRESH_SECRET=cambia_esto_por_otro_secreto_largo_y_aleatorio

# CORS: orígenes permitidos separados por coma (sin espacios), solo para producción
ALLOWED_ORIGINS=https://tuapp.com,https://admin.tuapp.com

